{
  "name": "haze-tracker-bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "deploy": "node scripts/deploy-guard.mjs && npm run build && tgcloud push",
    "test": "node --test test/",
    "card:assets": "node scripts/card/build-assets.mjs",
    "psi:history": "node scripts/psi-history.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tgcloud/cli": "^0.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  }
}
